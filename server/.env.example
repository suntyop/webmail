# ---- Serveur HTTP ----
PORT=3001
# URL du frontend autorisée (CORS) en développement
CLIENT_ORIGIN=http://localhost:5173
# Secret utilisé pour signer le cookie de session (mets une longue chaîne aléatoire)
SESSION_SECRET=change-me-please-use-a-long-random-string

# ---- Serveur mail (IMAP / lecture) ----
IMAP_HOST=mail.exemple.com
IMAP_PORT=993
IMAP_SECURE=true

# ---- Serveur mail (SMTP / envoi) ----
SMTP_HOST=mail.exemple.com
SMTP_PORT=465
SMTP_SECURE=true

# Durée d'inactivité avant expiration d'une session (en minutes)
SESSION_TTL_MINUTES=120
